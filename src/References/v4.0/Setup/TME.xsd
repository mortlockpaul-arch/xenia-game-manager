<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://tempuri.org/TME.xsd" xmlns:tns="http://tempuri.org/TME.xsd">
  <xs:element name="TME">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TaskProcessors">
          <xs:complexType>
            <xs:sequence>
              <xs:element maxOccurs="unbounded" name="TaskProcessor">
                <xs:complexType>
                  <xs:attribute name="Id" type="xs:string" use="required" />
                  <xs:attribute name="ProgressDevianceThreshold" type="xs:unsignedByte" use="optional" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="TaskLists">
          <xs:complexType>
            <xs:sequence>
              <xs:element maxOccurs="unbounded" name="TaskList">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Tasks">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element maxOccurs="unbounded" name="Task">
                            <xs:complexType>
                              <xs:attribute name="Id" type="xs:string" use="required" />
                              <xs:attribute name="Type" type="xs:string" use="required" />
                              <xs:attribute name="Data" type="xs:string" use="required" />
                              <xs:attribute name="DisplayName" type="xs:string" use="required" />
                              <xs:attribute name="AlwaysReboots" type="xs:string" use="optional" />
                              <xs:attribute name="Feature" type="xs:string" use="optional" />
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                      <xs:unique name="TaskIdIsUnique">
                        <xs:selector xpath="Tasks" />
                        <xs:field xpath="@Id" />
                      </xs:unique>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="Id" type="xs:string" use="required" />
                  <xs:attribute name="DisplayName" type="xs:string" use="required" />
                </xs:complexType>
                <xs:key name="TaskIdIsUniqueKey">
                  <xs:selector xpath=".//tns:Task" />
                  <xs:field xpath="@Id" />
                </xs:key>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:key name="TaskProcessorTypeIdIsUniqueKey">
      <xs:selector xpath=".//tns:TaskProcessor" />
      <xs:field xpath="@Id" />
    </xs:key>
    <xs:key name="TaskListIdIsUniqueKey">
      <xs:selector xpath=".//tns:TaskList" />
      <xs:field xpath="@Id" />
    </xs:key>
    <xs:keyref name="TaskTypeIsFoundTaskProcessorId" refer="tns:TaskProcessorTypeIdIsUniqueKey">
      <xs:selector xpath=".//tns:Task" />
      <xs:field xpath="@Type" />
    </xs:keyref>
  </xs:element>
</xs:schema>